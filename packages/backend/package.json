{
  "name": "@boardgames/backend",
  "version": "0.1.0",
  "description": "Cloudflare Workers backend for BoardGamesEpic",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.ts --bundle --platform=node --target=es2020 --outfile=dist/index.js",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "hono": "^3.11.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "@cloudflare/workers-types": "^4.20240815.0"
  },
  "devDependencies": {
    "wrangler": "^3.26.0",
    "@types/node": "^20.10.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.2",
    "typescript": "^5.3.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "vitest": "^1.0.0"
  }
}
