# Cloudflare
CLOUDFLARE_ACCOUNT_ID=05607df215f6fbb6d85e742ca0e6bc59
CLOUDFLARE_API_TOKEN=your_api_token_here

# Secrets (set with `wrangler secret put NAME --env <env>`; never commit real values)
JWT_SECRET=your_jwt_secret_here
# Optional: use Anthropic Claude instead of Workers AI for the assistant
ANTHROPIC_API_KEY=
# Optional: Google Places (New) for richer POI data. Deep links to Google Maps work without it.
GOOGLE_MAPS_API_KEY=
# Optional: Ticketmaster Discovery API for live events. Deep links work without it.
TICKETMASTER_API_KEY=

# Plain vars live in wrangler.toml [vars]: PROJECT_SHARE, TENANT_CAPACITY, SYSTEM_RESERVE, AI_MODEL
